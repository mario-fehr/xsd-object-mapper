parameters:
	ignoreErrors:
		-
			message: '#^Method Xsd2Php\\Attribute\\SymfonyValidatorAttributeStrategy\:\:attributesFor\(\) should return list\<array\{fqcn\: string, args\: string\}\> but returns array\.$#'
			identifier: return.type
			count: 2
			path: src/Attribute/SymfonyValidatorAttributeStrategy.php

		-
			message: '#^Method Xsd2Php\\Attribute\\SymfonyValidatorAttributeStrategy\:\:facetConstraints\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Attribute/SymfonyValidatorAttributeStrategy.php

		-
			message: '#^Method Xsd2Php\\Attribute\\SymfonyValidatorAttributeStrategy\:\:minMaxArgs\(\) has parameter \$facets with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Attribute/SymfonyValidatorAttributeStrategy.php

		-
			message: '#^Method Xsd2Php\\Attribute\\SymfonyValidatorAttributeStrategy\:\:presenceConstraint\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Attribute/SymfonyValidatorAttributeStrategy.php

		-
			message: '#^Part \$facets\[\$maxKey\] \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 1
			path: src/Attribute/SymfonyValidatorAttributeStrategy.php

		-
			message: '#^Part \$facets\[\$minKey\] \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 1
			path: src/Attribute/SymfonyValidatorAttributeStrategy.php

