parameters:
	ignoreErrors:
		-
			message: '#^Method Xsd2Php\\Attribute\\SymfonyValidatorAttributeStrategy\:\:attributesFor\(\) should return list\<array\{fqcn\: string, args\: string\}\> but returns array\.$#'
			identifier: return.type
			count: 2
			path: src/Attribute/SymfonyValidatorAttributeStrategy.php

		-
			message: '#^Method Xsd2Php\\Attribute\\SymfonyValidatorAttributeStrategy\:\:facetConstraints\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Attribute/SymfonyValidatorAttributeStrategy.php

		-
			message: '#^Method Xsd2Php\\Attribute\\SymfonyValidatorAttributeStrategy\:\:minMaxArgs\(\) has parameter \$facets with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Attribute/SymfonyValidatorAttributeStrategy.php

		-
			message: '#^Method Xsd2Php\\Attribute\\SymfonyValidatorAttributeStrategy\:\:presenceConstraint\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Attribute/SymfonyValidatorAttributeStrategy.php

		-
			message: '#^Part \$facets\[\$maxKey\] \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 1
			path: src/Attribute/SymfonyValidatorAttributeStrategy.php

		-
			message: '#^Part \$facets\[\$minKey\] \(mixed\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 1
			path: src/Attribute/SymfonyValidatorAttributeStrategy.php

		-
			message: '#^Possibly invalid array key type string\|null\.$#'
			identifier: offsetAccess.invalidOffset
			count: 5
			path: src/Generator.php

		-
			message: '#^Cannot call method getConstraint\(\) on Symfony\\Component\\Validator\\ConstraintViolationInterface\|null\.$#'
			identifier: method.nonObject
			count: 2
			path: tests/Attribute/SemanticTypeAttributeStrategyTest.php

		-
			message: '#^Method Xsd2Php\\Tests\\GeneratorTest\:\:readGenerated\(\) should return string but returns string\|false\.$#'
			identifier: return.type
			count: 1
			path: tests/GeneratorTest.php

		-
			message: '#^Parameter \#1 \$objectOrClass of class ReflectionClass constructor expects class\-string\<TestGen\\CartItemType\>\|TestGen\\CartItemType, string given\.$#'
			identifier: argument.type
			count: 1
			path: tests/GeneratorTest.php

		-
			message: '#^Parameter \#2 \$haystack of method PHPUnit\\Framework\\Assert\:\:assertCount\(\) expects Countable\|iterable, list\<string\>\|false given\.$#'
			identifier: argument.type
			count: 1
			path: tests/GeneratorTest.php

		-
			message: '#^Parameter \$xsdPaths of class Xsd2Php\\Config constructor expects array\<string\>, list\<string\>\|false given\.$#'
			identifier: argument.type
			count: 1
			path: tests/GeneratorTest.php

		-
			message: '#^Cannot call method getConstraint\(\) on Symfony\\Component\\Validator\\ConstraintViolationInterface\|null\.$#'
			identifier: method.nonObject
			count: 12
			path: tests/SymfonyValidatorAttributeStrategyTest.php

		-
			message: '#^Cannot call method getPropertyPath\(\) on Symfony\\Component\\Validator\\ConstraintViolationInterface\|null\.$#'
			identifier: method.nonObject
			count: 3
			path: tests/SymfonyValidatorAttributeStrategyTest.php

		-
			message: '#^Parameter \#1 \$haystack of function substr_count expects string, string\|false given\.$#'
			identifier: argument.type
			count: 2
			path: tests/SymfonyValidatorAttributeStrategyTest.php

		-
			message: '#^Parameter \#2 \$string of method PHPUnit\\Framework\\Assert\:\:assertMatchesRegularExpression\(\) expects string, string\|false given\.$#'
			identifier: argument.type
			count: 3
			path: tests/SymfonyValidatorAttributeStrategyTest.php

		-
			message: '#^Property class@anonymous/tests/Validator/ExactlyOneOfValidatorTest\.php\:60\:\:\$items type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
