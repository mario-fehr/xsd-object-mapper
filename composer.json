{
    "name": "mario-fehr/xsd2php",
    "description": "Generates PHP value-object classes from XSD schemas.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-dom": "*",
        "symfony/filesystem": "^7.0 || ^8.0",
        "symfony/validator": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "symfony/intl": "^7.0 || ^8.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.6",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Xsd2Php\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xsd2Php\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run",
        "rector-fix": "rector process",
        "deps-check": "composer-dependency-analyser"
    }
}
