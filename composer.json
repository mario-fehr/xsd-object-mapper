{
    "name": "mario-fehr/xsd2php",
    "description": "Generates PHP value-object classes from XSD schemas.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "symfony/filesystem": "^7.0 || ^8.0",
        "symfony/validator": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "symfony/intl": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Xsd2Php\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xsd2Php\\Tests\\": "tests/"
        }
    }
}
