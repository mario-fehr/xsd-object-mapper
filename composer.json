{
    "name": "mario-fehr/xsd-object-mapper",
    "description": "Generates PHP value-object classes from XSD schemas.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/mario-fehr/xsd-object-mapper",
    "support": {
        "issues": "https://github.com/mario-fehr/xsd-object-mapper/issues",
        "source": "https://github.com/mario-fehr/xsd-object-mapper"
    },
    "keywords": [
        "xsd",
        "xml-schema",
        "code-generation",
        "value-object",
        "symfony"
    ],
    "authors": [
        {
            "name": "Mario Fehr",
            "email": "mario.fehr@gmx.at"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-dom": "*",
        "symfony/filesystem": "^7.4|^8.0",
        "symfony/validator": "^7.4|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "symfony/intl": "^7.4|^8.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.6",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "XsdObjectMapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XsdObjectMapper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run",
        "rector-fix": "rector process",
        "deps-check": "composer-dependency-analyser"
    }
}
