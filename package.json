{
  "name": "xsd-object-mapper",
  "private": true,
  "description": "Markdown formatting/linting tooling for xsd-object-mapper's docs (no other JS in this repo)",
  "scripts": {
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\""
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6"
  }
}
